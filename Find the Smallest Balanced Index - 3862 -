class Solution {
public:
    int smallestBalancedIndex(vector<int>& nums) {
        int n = nums.size();
        if(n == 1) return -1;
        vector<unsigned long long> prefix(n), suffix(n, 1e14);
        prefix[0] = 1LL * nums[0];
        for(int i = 1;i<n;i++){
            prefix[i] = 1LL * nums[i] + prefix[i-1];
        }
        suffix[n-1] = 1LL * nums[n-1];
        for(int i = n-2; i>= 0;i--){
            if(suffix[i+1] * (1LL * nums[i]) > 1e14) suffix[i] = 1e14;
            else suffix[i] = suffix[i+1] * 1LL * nums[i];
        }
        for(int i = 0;i<n;i++){
            if(i == 0){
                if(suffix[i+1] == 0) return i;
            }
            else if(i == n-1){
                if(prefix[i-1] == 1) return i;
            }
            else if(prefix[i-1] == suffix[i+1]) return i;

            
        }
        return -1;
    }
};
