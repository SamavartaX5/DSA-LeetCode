    //         for(auto &val : right){
    //             ans.insert(val ^ grid[i][j]);
    //         }
    //     }

        
        
    //     return dp[i][j] = ans;
    // }
    int minCost(vector<vector<int>>& grid) {
        int m = grid.size(), n = grid[0].size();

        dp.assign(m, vector<unordered_set<int>>(n));

        dp[0][0].insert(grid[0][0]);

        for(int i = 0;i<m;i++){
            for(int j = 0;j<n;j++){
                for(auto val : dp[i][j]){

                    if(i + 1 < m){
                        dp[i+1][j].insert(val ^ grid[i+1][j]);
                    }

                    if(j + 1 < n){
                        dp[i][j+1].insert(val ^ grid[i][j+1]);
                    }
                }
            }
        }
        int ans = INT_MAX;
        for(auto val : dp[m-1][n-1]){
            ans = min(ans, (int)val);
        }
        return ans;
    }
};
